COMPOSE_BACKEND_IMAGE=uneton-backend:orb
CADDY_PUBLIC_HOST=http://api.uneton-vps-orb.localhost
UNETON_HTTP_LISTEN_ADDRESS=0.0.0.0:8080
UNETON_DATABASE_PATH=/data/uneton.sqlite
UNETON_AUTH_TOKEN_SECRET=GENERATE_AT_REHEARSAL
UNETON_RUNTIME_ENVIRONMENT=production
UNETON_LOG_FORMAT=json
UNETON_LOG_LEVEL=info
UNETON_RUNTIME_SHUTDOWN_TIMEOUT=30s
UNETON_AUTH_APPLE_CLIENT_ID=solutions.bytesized.uneton
UNETON_AUTH_APPLE_SERVER_NOTIFICATION_URL=https://api.uneton-vps-orb.localhost/apple/server-notifications
UNETON_AUTH_APPLE_TOKEN_ENCRYPTION_ACTIVE_KEY_ID=orb-rehearsal
UNETON_AUTH_APPLE_TOKEN_ENCRYPTION_KEYRING_JSON=GENERATE_AT_REHEARSAL
UNETON_INTEGRATION_APPLE_TEAM_ID=ORBTEAM
UNETON_INTEGRATION_APPLE_PRIVATE_KEY_ID=ORBKEY
UNETON_INTEGRATION_APPLE_PRIVATE_KEY_PEM=GENERATE_AT_REHEARSAL
LITESTREAM_REPLICA_URL=file:///backup

#!/usr/bin/env bash

set -euo pipefail

repo_root="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
mode="${1:---local}"

case "$mode" in
  --local|--publish) ;;
  *) echo "usage: ghcr [--local|--publish]" >&2; exit 2 ;;
esac

[[ -z "$(git -C "$repo_root" status --porcelain)" ]] || {
  echo "Commit or remove local changes before building a commit-tagged image" >&2
  exit 2
}

revision="$(git -C "$repo_root" rev-parse HEAD)"
image="ghcr.io/villeheikkila/uneton-backend:$revision"

args=(
  buildx build
  --pull
  --file "$repo_root/platform/backend/Dockerfile"
  --tag "$image"
  --label "org.opencontainers.image.revision=$revision"
  --label "org.opencontainers.image.source=https://github.com/villeheikkila/uneton"
)

if [[ "$mode" == --publish ]]; then
  # Log in with the GHCR credential from the production Fnox profile inside a
  # throwaway Docker config, so no registry token is saved on this machine.
  buildx_plugin="$(docker info --format '{{range .ClientInfo.Plugins}}{{if eq .Name "buildx"}}{{.Path}}{{end}}{{end}}')"
  [[ -n "$buildx_plugin" ]] || { echo "docker buildx is required" >&2; exit 127; }
  DOCKER_CONFIG="$(mktemp -d)"
  export DOCKER_CONFIG
  fnox_get() { fnox --config "$repo_root/fnox.toml" --no-daemon --profile production get "$1"; }
  # Write the registry auth into the throwaway config instead of `docker login`.
  # A config that already holds auths keeps Docker on its file store; otherwise
  # macOS Docker picks osxkeychain and would save the token in Keychain. Keep the
  # CLI plugin directory (buildx) that the default config provides.
  auth="$(printf '%s:%s' "$(fnox_get UNETON_GHCR_USERNAME)" "$(fnox_get UNETON_GHCR_TOKEN)" | base64 | tr -d '\n')"
  printf '{"auths":{"ghcr.io":{"auth":"%s"}},"cliPluginsExtraDirs":["%s"]}\n' \
    "$auth" "$(dirname "$buildx_plugin")" >"$DOCKER_CONFIG/config.json"
  unset auth
  builder="uneton-release-$$"
  cleanup() {
    docker buildx rm "$builder" >/dev/null 2>&1 || true
    rm -rf "$DOCKER_CONFIG"
  }
  trap cleanup EXIT
  # SBOM and provenance attestations need a docker-container builder; the
  # default docker driver rejects them.
  docker buildx create --name "$builder" --driver docker-container >/dev/null
  # Attach an SBOM and build provenance so the published digest can be audited.
  args+=(--builder "$builder" --platform "linux/amd64,linux/arm64" --sbom=true --provenance=mode=max --push)
else
  args+=(--platform linux/arm64 --load)
fi

docker "${args[@]}" "$repo_root"

if [[ "$mode" == --publish ]]; then
  docker buildx imagetools inspect "$image"
fi

echo "Backend image: $image"

#!/usr/bin/env bash

set -euo pipefail

if [[ "$#" -ne 2 || ! "$1" =~ ^[0-9]+(\.[0-9]+){1,2}$ || ! "$2" =~ ^[0-9]+$ ]]; then
  echo "usage: ios-build VERSION BUILD_NUMBER" >&2
  exit 2
fi

version="$1"
build_number="$2"
repo_root="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"

[[ -z "$(git -C "$repo_root" status --porcelain)" ]] || {
  echo "Commit or remove local changes before building a release artifact" >&2
  exit 2
}

revision="$(git -C "$repo_root" rev-parse HEAD)"
artifact_base="$repo_root/.asc/artifacts/Uneton-$version-$build_number-$revision"
archive="$artifact_base.xcarchive"
ipa="$artifact_base.ipa"

command -v asc >/dev/null
mkdir -p "$repo_root/.asc/artifacts"

# Signing uses the App Store Connect API key that asc already holds, so the
# Mac needs no Apple ID signed in to Xcode and automatic signing can refresh
# profiles after capability changes. The key is exported to a private
# temporary directory for this build only.
key_dir="$(mktemp -d)"
trap 'rm -rf "$key_dir"' EXIT
asc auth export-to-config --confirm --config "$key_dir/config.json" --private-key-dir "$key_dir" --output json >/dev/null
key_id="$(jq -er '.key_id' "$key_dir/config.json")"
issuer_id="$(jq -er '.issuer_id' "$key_dir/config.json")"
key_path="$(jq -er '.private_key_path' "$key_dir/config.json")"
[[ -f "$key_path" ]] || { echo "App Store Connect API key file not found" >&2; exit 2; }

asc xcode archive \
  --workspace "$repo_root/clients/ios/UnetonWorkspace.xcworkspace" \
  --scheme Uneton \
  --configuration Release \
  --archive-path "$archive" \
  --xcodebuild-flag=-destination \
  --xcodebuild-flag=generic/platform=iOS \
  --xcodebuild-flag=-allowProvisioningUpdates \
  --xcodebuild-flag=-authenticationKeyPath --xcodebuild-flag="$key_path" \
  --xcodebuild-flag=-authenticationKeyID --xcodebuild-flag="$key_id" \
  --xcodebuild-flag=-authenticationKeyIssuerID --xcodebuild-flag="$issuer_id" \
  --xcodebuild-flag="MARKETING_VERSION=$version" \
  --xcodebuild-flag="CURRENT_PROJECT_VERSION=$build_number" \
  --output json

asc xcode export \
  --archive-path "$archive" \
  --ipa-path "$ipa" \
  --xcodebuild-flag=-allowProvisioningUpdates \
  --xcodebuild-flag=-authenticationKeyPath --xcodebuild-flag="$key_path" \
  --xcodebuild-flag=-authenticationKeyID --xcodebuild-flag="$key_id" \
  --xcodebuild-flag=-authenticationKeyIssuerID --xcodebuild-flag="$issuer_id" \
  --output json

echo "App Store IPA: $ipa"

#!/usr/bin/env bash

set -euo pipefail

if [[ "$#" -lt 1 || "$#" -gt 2 ]]; then
  echo "usage: ios-upload IPA_PATH [--publish]" >&2
  exit 2
fi

ipa="$1"
mode="${2:---dry-run}"
case "$mode" in
  --dry-run|--publish) ;;
  *) echo "usage: ios-upload IPA_PATH [--publish]" >&2; exit 2 ;;
esac

[[ -f "$ipa" ]] || { echo "IPA not found: $ipa" >&2; exit 2; }
[[ -n "${ASC_APP_ID:-}" ]] || { echo "Set ASC_APP_ID to the App Store Connect app ID" >&2; exit 2; }

command -v asc >/dev/null
actual_bundle="$(asc apps view --id "$ASC_APP_ID" --output json | jq -er '.data.attributes.bundleId')"
[[ "$actual_bundle" == solutions.bytesized.uneton ]] || {
  echo "App $ASC_APP_ID has bundle ID $actual_bundle; expected solutions.bytesized.uneton" >&2
  exit 2
}
args=(publish appstore --app "$ASC_APP_ID" --ipa "$ipa" --platform IOS --wait)
if [[ "$mode" == --dry-run ]]; then
  args+=(--dry-run --output table)
fi

asc "${args[@]}"
